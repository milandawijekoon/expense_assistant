# --- Database (docker-compose uses these for the db service and the backend) ---
POSTGRES_USER=expense
POSTGRES_PASSWORD=expense
POSTGRES_DB=expense
# Used when running the backend outside Docker:
DATABASE_URL=postgresql+psycopg://expense:expense@localhost:5432/expense

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-change-me-change-me-1234
JWT_EXPIRE_MINUTES=60

# --- CORS: comma-separated browser origins allowed to call the API ---
FRONTEND_ORIGIN=http://localhost:3000

# --- LLM (optional server-wide fallback; users can set their own provider/key in Settings) ---
# "anthropic", "openai" or "ollama"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# --- Rate limiting for /expenses/parse and /assistant/chat (per user) ---
RATE_LIMIT_ENABLED=true
LLM_RATE_LIMIT=20/minute
# Per client IP on /auth/login and /auth/register
AUTH_RATE_LIMIT=10/minute

# --- Misc ---
DEFAULT_CURRENCY=INR
LOG_LEVEL=INFO

# --- Frontend (public, baked into the browser bundle) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
